{
  "manifest_version": 3,
  "name": "Bangumi 域名切换",
  "version": "1.0.0",
  "description": "在 bgm.tv 与 bangumi.tv 之间一键切换，并在页面左下角提供与原站风格一致的 Bangumi / Bgm 滑块。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Bangumi 域名切换",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "*://bgm.tv/*",
    "*://www.bgm.tv/*",
    "*://bangumi.tv/*",
    "*://www.bangumi.tv/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://bgm.tv/*",
        "*://www.bgm.tv/*",
        "*://bangumi.tv/*",
        "*://www.bangumi.tv/*"
      ],
      "js": [
        "lib.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
